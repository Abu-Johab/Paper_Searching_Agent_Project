# OpenAlex polite pool email (free, recommended by OpenAlex for faster and reliable responses)
OPENALEX_EMAIL=your_email@example.com

# IEEE Xplore API key (optional; if empty or missing, IEEE search is skipped gracefully)
IEEE_API_KEY=

# Telegram bot notifications (optional; if empty or missing, Telegram sending is skipped)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily Email notifications (SMTP / Gmail App Password)
EMAIL_NOTIFICATIONS_ENABLED=true
RECIPIENT_EMAIL=abujohab@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_SENDER_NAME=Paper Searching Agent
SMTP_USE_TLS=true

# ==============================================================================
# LLM Provider Configuration
# Choose: "auto", "gemini", "groq", "openai", "deepseek", "ollama", or "regex_only"
# If set to "auto" (default), it automatically uses the first available API key below,
# or falls back to local Ollama if online, or regex heuristics if neither is set.
# ==============================================================================
LLM_PROVIDER=auto

# Option 1 (Recommended & 100% Free): Google Gemini API
# Get a free key in 30 seconds at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 2 (Free & Ultra Fast): Groq Cloud API
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: OpenAI / DeepSeek / Any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 4: Local or Self-Hosted Ollama (No API key needed, but requires Ollama installed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b
OLLAMA_FALLBACK_MODEL=qwen2.5:14b
